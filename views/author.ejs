<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">  
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"  rel="stylesheet" 
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"  crossorigin="anonymous">
    <title>portfolio</title>
  </head>
  <body>
     <div class="frame">
        <div class="main_frame"></div>
        <div class="left_frame">
            <div class="left_1">
                <div class="left_1-1">
                    <img src="images/s.png"
                    width="170px"
                    height="175px"
                    alt=""
                    />
                </div>
                <div class="left_1-2"><%=user.name%></div>
                <div class="left_1-3"><%=user.profession%></div>
                <div class="left_1-icon">
                    <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/dribbble.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/facebook.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/instagram.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/linkedin.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/twitter.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/youtube.svg" class="icon-1">
                            </div>
                        </a>
                </div>
            </div>
            <div class="marginer"></div>

    
            <div class="left_2">
                <div class="left_2-1">
                     <div class="info">Age:</div>
                     <div><%=user.age%></div>
                </div>
                <div class="left_2-1">
                     <div class="info">residence:</div>
                     <div><%=user.residence%></div>
                </div>
                <div class="left_2-1">
                     <div class="info">freelance:</div>
                     <div style="color: green;"><%=user.freelance%></div>
                </div>
                <div class="left_2-1">
                     <div class="info">adress:</div>
                     <div><%=user.adress%></div>
                </div>
            </div>
            <div class="marginer"></div>

            <div class="left_3">
                <div style="margin-top: -30px; padding-bottom: 10px; font-weight: bolder;">Languages</div>

                <div class="left_3_lan"> <%=user.languages[0]%>
                    <div> 100%</div>
                </div>   
                <div class="progress-bg"><div class="progress-fill" style="width: 100%;"></div></div>


                <div class="left_3_lan"> <%=user.languages[1]%>
                    <div> 70%</div>
                </div>
                <div class="progress-bg"><div class="progress-fill" style="width: 70%;"></div></div>

                <div class="left_3_lan"> <%=user.languages[2]%>
                    <div>60%</div>
                </div>
                <div class="progress-bg"><div class="progress-fill" style="width: 60%;"></div></div>
              </div>
             

            <div class="marginer"></div>

            
            <div class="left_4">
                <div style="margin-top: -20px;padding-bottom: 10px; font-weight: 900;">Skills</div>

                 <div class="left_4_skill">
                        <div><%=user.skills[0]%></div>
                        <div>80%</div>
                    </div>
                    <div class="progress-bg"><div class="progress-fill" style="width: 90%;"></div></div>
                    <div class="left_4_skill">
                        <div><%=user.skills[1]%></div>
                        <div>80%</div>
                    </div>
                    <div class="progress-bg"><div class="progress-fill" style="width: 85%;"></div></div>
                    <div class="left_4_skill">
                        <div><%=user.skills[2]%></div>
                        <div>80%</div>
                    </div>
                    <div class="progress-bg"><div class="progress-fill" style="width: 80%;"></div></div>
                    <div class="left_4_skill">
                        <div><%=user.skills[3]%></div>
                        <div>70%</div>
                    </div>
                    <div class="progress-bg"><div class="progress-fill" style="width: 75%;"></div></div>

            </div>

            <div class="marginer"></div>


            <div class="left_5">
               <div style="margin-bottom: 15px; font-weight: bolder;">Extra Skills</div>

                   <div class="left_5_extra">
                        <img src="icon/icons.svg" style="margin-right: 8px;">
                        <div><%=user.extra_skills[0]%></div>
                        <div><%=user.extra_skills[1]%></div>
                   </div>   
                   <div class="left_5_extra">
                        <img src="icon/icons.svg" style="margin-right: 8px;">
                        <div><%=user.extra_skills[2]%></div>
                         <div><%=user.extra_skills[3]%></div>
                         <div><%=user.extra_skills[4]%></div>
                    </div>
                    <div class="left_5_extra">
                        <img src="icon/icons.svg" style="margin-right: 8px;">
                        <div><%=user.extra_skills[5]%></div>
                        <div><%=user.extra_skills[6]%></div>
                    </div>
            </div>


         <div class="marginer"></div>
        </div>


        <div class="midd_frame">
             <div class="midd_1">
            
                 <div class="midd_1_1">
                        <div class="midd_1_1_text1">Web Developer & Software Engineer</div>
                        <div class="midd_1_1_text2">Hi, I'm Sanjarbek. I create modern web applications using HTML, CSS, JavaScript and Node.js.</div>
                        <button class="button">HIRE ME ></button>
                        
                    </div>

                  <div>
                        <img style="width: 420px; height: 400px; padding-left: 100px;"    src="images/s.png" alt="">
                    </div>
                </div>


                <div class="midd_2">
                    <div class="midd_2_1">My Services</div>
                    <div class="midd_2_2"><%=user.service_desc%></div>
                    <div class="midd_2_3">
                        <div class="midd_2_3_template">
                            <img class="service_image" src="menu_icon/web-icon.svg" alt="">
                            <div class="service_name">Web Development</div>
                            <div class="service_name_detail">Blog, E-Commerce</div>
                        </div>
                        <div class="midd_2_3_template">
                            <img class="service_image" src="menu_icon/ux-icon.svg" alt="">
                            <div class="service_name">UI/UX Design</div>
                            <div class="service_name_detail">Mobile App, Website Design</div>
                        </div>
                        <div class="midd_2_3_template">
                            <img class="service_image" src="menu_icon/ux-icon.svg" alt="">
                            <div class="service_name">UI/UX Design</div>
                            <div class="service_name_detail">Mobile App, Website Design</div>
                        </div>
                  </div>


                   <div class="midd_2_3">
                        <div class="midd_2_3_template">
                            <img class="service_image" src="menu_icon/game-icon.svg" alt="">
                            <div class="service_name">Game Design</div>
                            <div class="service_name_detail">Character Design, Props & Objects</div>
                        </div>
                        
                        <div class="midd_2_3_template">
                            <img class="service_image" src="menu_icon/photograph-icon.svg" alt="">
                            <div class="service_name">Photography</div>
                            <div class="service_name_detail">Portrait, Product Photography</div>
                        </div>

                        <div class="midd_2_3_template">
                            <div class="advertising">Advertising</div>
                            <div class="advertising_text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Praesentium animi consequatur a consequuntur inventore dolore.</div>
                            <div><a href="www.google.com" class="order">ORDER NOW ></a></div>
                        </div>
                    </div>          
 



                   </div>
               </div>

               <div class="right_frame">
                   <div class="contrast">
                         <img src="btn_icon/icons_contrast.svg" alt="">
                    </div>

                <div class="home_tooltip">
                                
                     <div class="home_text"></div>
                    <div class="home_icon">
                        <img src="btn_icon/icons_Home.svg" alt="">
                    </div>
               </div>              

                <button class="btn_icons">
                    <img src="btn_icon/file-code.svg" alt=""> 
                </button>
                <button class="btn_icons">
                    <img src="btn_icon/icons_cv.svg" alt="">
                </button>
                <button class="btn_icons">
                    <img src="btn_icon/icons_contact.svg" alt="">
                </button>
                <button class="btn_icons">
                    <img src="btn_icon/icons_Blog.svg" alt="">
                </button>
                 <button class="btn_icons">
                    <img src="btn_icon/icons_portfolio.png" alt="">
                </button>

            </div>

        





         </div>
      </div>
  </body> 
</html> 